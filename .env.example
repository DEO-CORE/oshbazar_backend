# =============================================================================
# Ош Базар — пример конфигурации окружения.
# Скопируйте в .env и заполните значения. Файл .env не коммитится.
# =============================================================================

# --- Django core -------------------------------------------------------------
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Bishkek
APP_NAME=Ош Базар — учёт электроэнергии
# Только dev: писать логи только в консоль, без файла logs/.
DISABLE_FILE_LOGGING=false

# --- База данных -------------------------------------------------------------
# dev (по умолчанию): sqlite3. prod: django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=60
# В production требовать не-sqlite БД (по умолчанию true)
REQUIRE_POSTGRES=true

# --- JWT ---------------------------------------------------------------------
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14
# По умолчанию = DJANGO_SECRET_KEY
JWT_SIGNING_KEY=

# --- CORS --------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=

# --- Показания (ТЗ, п. 3, 9) ------------------------------------------------
# Требовать подтверждение контролёром (approve) перед начислением.
READINGS_REQUIRE_APPROVAL=false
# Разрешать показание меньше предыдущего.
READINGS_ALLOW_DECREASE=false
# Обязательность фото счётчика при передаче показаний.
READING_PHOTO_REQUIRED=false
READING_PHOTO_MAX_MB=10
READING_PHOTO_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# --- Биллинг / аванс (ТЗ, п. 4) ---------------------------------------------
# Автоматически гасить новые начисления положительным балансом (авансом).
AUTO_APPLY_CREDIT=true
PAYMENT_DUE_DAYS=10
PAYMENT_DUE_REMINDER_DAYS=3
RECEIPT_PREFIX=OB

# --- Платежи (ТЗ, п. 5) ------------------------------------------------------
PAYMENT_DEFAULT_PROVIDER=mock
PAYMENT_CURRENCY=KGS
# HMAC-секрет для проверки подписи X-Signature вебхуков банка.
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# Класс провайдера для кода "opt" (например, реальный банковский шлюз).
PAYMENT_PROVIDER_OPT_CLASS=apps.payments.providers.mock.MockBankProvider

# --- Уведомления / Push (ТЗ, п. 7) ------------------------------------------
PUSH_ENABLED=false
# logging | apps.notifications.push.FCMPushBackend | apps.notifications.push.HTTPPushBackend
PUSH_BACKEND=apps.notifications.push.LoggingPushBackend
PUSH_API_KEY=
# Для HTTPPushBackend — URL шлюза; для FCM — переопределение эндпоинта (опц.).
PUSH_ENDPOINT=
PUSH_FCM_ENDPOINT=
PUSH_AUTH_HEADER=Authorization
PUSH_TIMEOUT=10

# --- Интеграция с 1С (ТЗ, п. 6) ---------------------------------------------
ONES_C_ENABLED=false
ONES_C_BASE_URL=
ONES_C_USERNAME=
ONES_C_PASSWORD=
ONES_C_TIMEOUT=30
ONES_C_CLIENT=apps.integrations.clients.Http1CClient

# --- Статика / медиа ---------------------------------------------------------
MEDIA_ROOT_NAME=media
STORAGES_DEFAULT_BACKEND=django.core.files.storage.FileSystemStorage
STORAGES_STATICFILES_BACKEND=django.contrib.staticfiles.storage.ManifestStaticFilesStorage

# --- Объектное хранилище S3 / MinIO (ТЗ, п. 3) ------------------------------
USE_S3_STORAGE=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Для MinIO / S3-совместимых: например http://minio:9000
AWS_S3_ENDPOINT_URL=
# Публичный домен/CDN для отдачи файлов (без подписи).
AWS_S3_CUSTOM_DOMAIN=
# Подписывать URL (true для приватного бакета; false если публичный/CDN).
AWS_QUERYSTRING_AUTH=true
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_URL_PROTOCOL=https:
AWS_DEFAULT_ACL=

# --- Безопасность (production, ТЗ, п. 9) ------------------------------------
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
